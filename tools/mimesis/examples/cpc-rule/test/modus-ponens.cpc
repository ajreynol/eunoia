; Existing CPC rule used as a model in ../../../docs/adding-a-cpc-rule.md.
; Expected: correct. Tested with Ethos; no Lean build was run here.
(declare-const p Bool)
(declare-const q Bool)
(assume @p p)
(assume @imp (=> p q))
(assume @nq (not q))
(step @q q :rule modus_ponens :premises (@p @imp))
(step @false false :rule contra :premises (@q @nq))
