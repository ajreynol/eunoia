; Two trailing comments, neither of which fits on the line it was written on.
(define $dt_is_cons ((T Type :implicit) (t T))
  (eo::ite (eo::is_eq t tuple)    ; tuple has no selectors, so it must be checked first of all
    true
    (eo::is_ok (eo::dt_selectors t)))) ; if it has selectors, then it is a constructor symbol
